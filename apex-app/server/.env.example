# Copy this file to .env and fill in real values. Never commit .env.
#
# Either naming style works (the server accepts both, checking the
# unprefixed name first): TOKEN_URL or ORACLE_TOKEN_URL, CLIENT_ID or
# ORACLE_CLIENT_ID, etc. Pick one style and fill in real values below.

# IDCS OAuth2 token endpoint
TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
SCOPE=
USERNAME=
PASSWORD=

# ORACLE_-prefixed equivalents (used by the AP Manager integration doc) —
# fill in ONE set (either the plain names above or these), not both.
# ORACLE_TOKEN_URL=https://idcs-feb0f174fe3d40b097ade74ccc60cb0d.identity.oraclecloud.com/oauth2/v1/token
# ORACLE_CLIENT_ID=
# ORACLE_CLIENT_SECRET=
# ORACLE_USERNAME=
# ORACLE_PASSWORD=
# ORACLE_SCOPE=urn:opc:resource:fusion:exye-test:fusion-ai/

# Oracle Fusion AI agent orchestrator base URL (no trailing slash)
FUSION_AI_BASE_URL=https://fa-exye-test-saasfaprod1.fa.ocs.oraclecloud.com

# Port this server listens on
PORT=4000

# Comma-separated list of origins allowed to call this server (CORS)
CORS_ORIGIN=http://localhost:5173

# Set to 1 to print the RAW invokeAsync/status JSON from Oracle to this
# server's terminal only (never sent to the browser) — useful the first
# time you run against real Oracle to confirm actual field names (job id,
# status, output) instead of guessing. Leave unset/0 normally.
ORACLE_DEBUG=0
