{
  "name": "apex-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:install": "npm install --prefix server",
    "server:dev": "npm run dev --prefix server",
    "setup": "npm install && npm run server:install",
    "dev:all": "concurrently -n frontend,backend -c blue,green \"npm run dev\" \"npm run server:dev\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.3",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "vite": "6.0.7"
  }
}
